# Public-safe service configuration template.
# Copy to services/.env locally and replace placeholders.

# Replay configuration
REPLAY_RATE=5
REPLAY_SCENARIO=mixed_chaos
DATASET_DIR=<DATASET_DIR>

# MQTT credentials
NODE_ID=<NODE_ID>
MQTT_HOST=<MQTT_HOST>
MQTT_BROKER=<MQTT_BROKER>
MQTT_PORT=1883
MQTT_USERNAME=<MQTT_USERNAME>
MQTT_PASSWORD=<MQTT_PASSWORD>

# IDS API
IDS_API_HOST=<IDS_API_HOST>
IDS_API_PORT=8000

# FL configuration
FL_SERVER_HOST=<FL_SERVER_HOST>
FL_SERVER_PORT=8080
FL_NUM_ROUNDS=10
TRAINING_MODE=mock
REAL_FL_EXPERIMENT=<REAL_FL_EXPERIMENT>
REAL_FL_ROUNDS=1
REAL_FL_WORKDIR=<REAL_FL_WORKDIR>

# Inference configuration
INFERENCE_THRESHOLD=0.5
MODEL_PATH=<MODEL_PATH>
SCALER_PATH=<SCALER_PATH>
LABEL_MAPPING_PATH=<LABEL_MAPPING_PATH>

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://<MLFLOW_HOST>:5000
GRAFANA_ADMIN_USER=<GRAFANA_ADMIN_USER>
GRAFANA_ADMIN_PASSWORD=<GRAFANA_ADMIN_PASSWORD>

# Quantum-inspired preprocessing
QGA_SERVICE_PORT=8020
QGA_DEFAULT_ITERATIONS=20

# Edge IDS Gateway profile
EDGE_GATEWAY_INFERENCE_THRESHOLD=0.5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
