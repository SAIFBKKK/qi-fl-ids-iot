      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(final_ids_api_prediction_errors_total[1m]))",
          "refId": "A",
          "legendFormat": "final API errors/sec"
        },
        {
          "expr": "sum(rate(final_mqtt_bridge_prediction_errors_total[1m]))",
          "refId": "B",
          "legendFormat": "bridge errors/sec"
        }
      ]
    },
    {
