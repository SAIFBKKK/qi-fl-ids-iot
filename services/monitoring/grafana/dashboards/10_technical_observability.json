          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(final_mqtt_bridge_http_latency_seconds_sum[1m])) / clamp_min(sum(rate(final_mqtt_bridge_http_latency_seconds_count[1m])), 1)",
          "refId": "A",
          "legendFormat": "mean"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(final_mqtt_bridge_http_latency_seconds_bucket[1m])) by (le))",
          "refId": "B",
          "legendFormat": "p95"
        }
      ]
